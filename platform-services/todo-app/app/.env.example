# Local development environment for the todo app.
# Copy to `.env` and adjust. In Kubernetes these come from the Helm chart,
# which is fed from the Bicep module outputs.

# Option A: full URL (takes precedence when set)
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/todos?sslmode=prefer

# Option B: individual parts
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=todos
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_SSLMODE=prefer

LOG_LEVEL=info
