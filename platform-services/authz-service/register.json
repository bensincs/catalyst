{
  "secretSets": [
    {
      "name": "authz secrets",
      "description": "Credentials the authorization service and its SpiceDB datastore run on. Supplied once per tenant and stored in that tenant's own Key Vault, where the platform cannot read them back.",
      "keys": [
        "spicedb-preshared-key",
        "authz-admin-token",
        "postgres-password"
      ]
    }
  ],
  "applications": [
    {
      "name": "App access",
      "description": "SpiceDB-backed authorization service for the data plane, with an admin UI for granting people access to hosted apps. Answers the gateway's access decisions and the role queries applications make.",
      "chart": "authz-service",
      "repoURL": "oci://cortexcpacr6hy6uurw.azurecr.io/charts",
      "targetRevision": "0.9.3",
      "namespace": "cortex-authz",
      "authRequired": true,
      "values": "routingDomain: msft.ae\ntenantId: t-8f646aa4a8c3c71e\nadminApp: authz-admin\nimage: cortexcpacr6hy6uurw.azurecr.io/images/authz-service:0.8.2\nseed:\n  enabled: true\n  app: authz-admin\n  role: admin\n  members:\n  - user:bensinclair@msft.ae\noidc:\n  issuer: https://login.microsoftonline.com/592f2526-87c5-4b56-a69c-911ca616e213/v2.0\n  audience: 6eb003c0-169c-4b12-bc5e-aa5d6af04f2b\n",
      "dependencies": [
        {
          "kind": "secret_set",
          "id": "authz-secrets"
        },
        {
          "kind": "infrastructure",
          "id": "authz-db"
        }
      ],
      "wiring": [
        {
          "sourceKind": "secret_set",
          "sourceId": "authz-secrets",
          "output": "secretName",
          "helmPath": "secrets.secretName"
        },
        {
          "sourceKind": "secret_set",
          "sourceId": "authz-secrets",
          "output": "key:spicedb-preshared-key",
          "helmPath": "secrets.spicedbPresharedKeyKey"
        },
        {
          "sourceKind": "secret_set",
          "sourceId": "authz-secrets",
          "output": "key:authz-admin-token",
          "helmPath": "secrets.adminTokenKey"
        },
        {
          "sourceKind": "secret_set",
          "sourceId": "authz-secrets",
          "output": "key:postgres-password",
          "helmPath": "secrets.postgresPasswordKey"
        },
        {
          "sourceKind": "infrastructure",
          "sourceId": "authz-db",
          "output": "host",
          "helmPath": "postgres.host"
        },
        {
          "sourceKind": "infrastructure",
          "sourceId": "authz-db",
          "output": "port",
          "helmPath": "postgres.port"
        },
        {
          "sourceKind": "infrastructure",
          "sourceId": "authz-db",
          "output": "administratorLogin",
          "helmPath": "postgres.user"
        },
        {
          "sourceKind": "infrastructure",
          "sourceId": "authz-db",
          "output": "databaseName",
          "helmPath": "postgres.database"
        },
        {
          "sourceKind": "infrastructure",
          "sourceId": "authz-db",
          "output": "sslMode",
          "helmPath": "postgres.sslMode"
        }
      ],
      "exposeService": "authz-service",
      "exposePort": 8080,
      "hostname": "authz-admin",
      "embed": true,
      "icon": "shield",
      "applicationHooks": [
        {
          "name": "authz app registration",
          "method": "PUT",
          "service": {
            "namespace": "cortex-authz",
            "name": "authz-service",
            "port": 8080
          },
          "path": "/v1/apps/{{app}}/roles/{{role}}",
          "body": "{}",
          "tokenSecret": {
            "namespace": "cortex-authz",
            "name": "cortex-secret-authz-secrets",
            "key": "authz-admin-token"
          },
          "tokenHeader": "X-Cortex-Hook-Token"
        }
      ],
      "roles": [
        "admin"
      ]
    }
  ],
  "infrastructure": [
    {
      "name": "authz db",
      "description": "SpiceDB's datastore for the authorization service. The admin password is read from the tenant's own Key Vault by ARM at deploy time, so the control plane never handles it.",
      "bicepModule": "br:cortexcpacr6hy6uurw.azurecr.io/bicep/authz:0.1.0",
      "bicepParams": {
        "name": "authz-{{tenantHash}}",
        "location": "{{region}}",
        "vaultName": "{{vaultName}}",
        "vaultResourceGroup": "{{vaultResourceGroup}}",
        "peSubnetId": "{{peSubnetId}}",
        "dnsZoneResourceGroup": "{{dnsZoneResourceGroup}}",
        "secretSetId": "authz-secrets",
        "administratorLogin": "authzadmin",
        "skuName": "Standard_B2ms",
        "skuTier": "Burstable",
        "storageMb": 32768,
        "backupRetentionDays": 7
      }
    }
  ]
}
