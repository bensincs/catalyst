{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.40.2.10011",
      "templateHash": "18249625714781335367"
    }
  },
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Azure region for all resources."
      }
    },
    "tenantName": {
      "type": "string",
      "metadata": {
        "description": "Your organization display name (shown in the Cortex fleet)."
      }
    },
    "controlPlaneUrl": {
      "type": "string",
      "defaultValue": "https://api.catalyst.msft.ae",
      "metadata": {
        "description": "Cortex control-plane API base URL."
      }
    },
    "cortexApiScope": {
      "type": "string",
      "defaultValue": "api://1680be6b-9a92-4244-b800-4d3b902fecff",
      "metadata": {
        "description": "Entra scope/resource for the Cortex control-plane API."
      }
    },
    "plan": {
      "type": "string",
      "defaultValue": "enterprise",
      "allowedValues": [
        "team",
        "enterprise",
        "sovereign"
      ],
      "metadata": {
        "description": "Plan tier."
      }
    },
    "foundryAccountName": {
      "type": "string",
      "defaultValue": "[format('cortex-ai-{0}', uniqueString(resourceGroup().id))]",
      "metadata": {
        "description": "Foundry account (AI Services) name — must be globally unique. Defaults to a stable per-resource-group name."
      }
    },
    "foundryProjectName": {
      "type": "string",
      "defaultValue": "agents-prod",
      "metadata": {
        "description": "Foundry project name the reconciler converges agents into."
      }
    },
    "modelDeploymentName": {
      "type": "string",
      "defaultValue": "gpt-4o",
      "metadata": {
        "description": "Model deployment name agents reference as their model."
      }
    },
    "modelName": {
      "type": "string",
      "defaultValue": "gpt-5",
      "metadata": {
        "description": "Chat model to deploy. Must be a currently-deployable (GenerallyAvailable) model — gpt-4o/gpt-4.1 are retired for new deployments in this region. The deployment NAME stays gpt-4o (modelDeploymentName) so existing agents/stores keep resolving."
      }
    },
    "modelVersion": {
      "type": "string",
      "defaultValue": "2025-08-07",
      "metadata": {
        "description": "Chat model version. Must be a currently-deployable version of modelName."
      }
    },
    "modelSkuName": {
      "type": "string",
      "defaultValue": "GlobalStandard",
      "metadata": {
        "description": "Model deployment SKU (throughput type)."
      }
    },
    "modelCapacity": {
      "type": "int",
      "defaultValue": 30,
      "metadata": {
        "description": "Model capacity, in thousands of tokens-per-minute. Foundry recommends >= 30 for agents/tools."
      }
    },
    "embeddingDeploymentName": {
      "type": "string",
      "defaultValue": "text-embedding-3-small",
      "metadata": {
        "description": "Embedding model deployment name — required by memory stores to index memories."
      }
    },
    "embeddingModelName": {
      "type": "string",
      "defaultValue": "text-embedding-3-small",
      "metadata": {
        "description": "Embedding model to deploy for memory stores."
      }
    },
    "embeddingModelVersion": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Embedding model version. Empty lets Azure pick the current default version."
      }
    },
    "embeddingSkuName": {
      "type": "string",
      "defaultValue": "GlobalStandard",
      "metadata": {
        "description": "Embedding model deployment SKU. GlobalStandard is available in every region (Standard is region-limited — e.g. absent in uksouth for text-embedding-3-small)."
      }
    },
    "embeddingCapacity": {
      "type": "int",
      "defaultValue": 30,
      "metadata": {
        "description": "Embedding capacity, in thousands of tokens-per-minute."
      }
    },
    "deployCluster": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "Deploy an AKS cluster for the tenant so the reconciler can bootstrap Argo CD and run Helm/GitOps workloads."
      }
    },
    "clusterName": {
      "type": "string",
      "defaultValue": "cortex-aks",
      "metadata": {
        "description": "AKS cluster name."
      }
    },
    "kubernetesVersion": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Kubernetes version (blank = the AKS default for the region)."
      }
    },
    "nodeVmSize": {
      "type": "string",
      "defaultValue": "Standard_D2s_v5",
      "metadata": {
        "description": "AKS system node pool VM size."
      }
    },
    "nodeCount": {
      "type": "int",
      "defaultValue": 2,
      "minValue": 1,
      "metadata": {
        "description": "AKS system node count."
      }
    },
    "workloadNodeVmSize": {
      "type": "string",
      "defaultValue": "Standard_D8s_v5",
      "metadata": {
        "description": "AKS workload node pool VM size. The system pool is deliberately small and sized for the platform's own components; anything a tenant installs runs here. A real application does not fit in the system pool — Insight alone requests over 6 vCPU, where two Standard_D2s_v5 system nodes offer under 4 in total."
      }
    },
    "workloadNodeCount": {
      "type": "int",
      "defaultValue": 2,
      "minValue": 0,
      "metadata": {
        "description": "AKS workload node count. Zero omits the pool entirely, for a footprint that will only ever run platform components."
      }
    },
    "acmeDirectoryUrl": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "ACME directory the reconciler obtains wildcard certificates from. Blank = Let's Encrypt production."
      }
    },
    "acmeEmail": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Contact address registered with the ACME provider (expiry notices)."
      }
    },
    "argocdVersion": {
      "type": "string",
      "defaultValue": "v2.13.2",
      "metadata": {
        "description": "Argo CD version the reconciler bootstraps into the cluster."
      }
    },
    "appsDomain": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "DNS suffix for per-app hosts served by the AKS-managed Azure Application Gateway (AGIC), e.g. apps.contoso.com gives <app>.apps.contoso.com. Empty = host-less routing via the gateway default backend."
      }
    },
    "helmOciRegistry": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Optional private OCI Helm registry (e.g. ghcr.io/bensincs) whose charts need the reconciler credentials. Public OCI registries are auto-registered anonymously from each app repoURL, so leave empty for those."
      }
    },
    "helmOciUsername": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Username for the platform registry — a registry-scoped token, not an Entra principal, so it works for a cluster in the customer's own directory."
      }
    },
    "helmOciPassword": {
      "type": "securestring",
      "defaultValue": "",
      "metadata": {
        "description": "Password for that token. It grants pull on the cached chart repositories of the platform registry only; the upstream registry credential never leaves the platform."
      }
    },
    "reconcilerImage": {
      "type": "string",
      "defaultValue": "ghcr.io/inception42/cortex-reconciler:latest",
      "metadata": {
        "description": "Reconciler container image (published by Cortex, or your own registry)."
      }
    },
    "registryServer": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Private registry server for the reconciler image (e.g. myacr.azurecr.io). Empty = a public image pulled without auth. When set, the reconciler identity pulls with its own identity and needs AcrPull on the registry."
      }
    },
    "reconcilerVersion": {
      "type": "string",
      "defaultValue": "0.1.0",
      "metadata": {
        "description": "Reconciler build/release version reported to the control plane (match the image tag)."
      }
    },
    "pollIntervalSeconds": {
      "type": "int",
      "defaultValue": 30,
      "minValue": 10,
      "maxValue": 300,
      "metadata": {
        "description": "Reconcile + heartbeat interval, in seconds."
      }
    },
    "deployReconcilerApp": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "Deploy the in-Azure reconciler container app. Set false to deploy only the Foundry backing (account/project/model + identity + RBAC) and run the reconciler elsewhere — e.g. locally."
      }
    },
    "reconcilerIdentityResourceId": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Resource id of a pre-created reconciler managed identity to use (platform-hosted tenants). Empty ⇒ the footprint creates its own (delegated tenants)."
      }
    },
    "isDelegated": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "Whether this footprint is deployed cross-tenant via Azure Lighthouse. false for platform-hosted tenants (same tenant), which omit the Lighthouse-only delegatedManagedIdentityResourceId on their role assignments."
      }
    },
    "tenantSlug": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "The Cortex tenant slug (platform-hosted tenants), surfaced to the reconciler for observability."
      }
    },
    "vaultName": {
      "type": "string",
      "defaultValue": "[format('cortex-kv-{0}', uniqueString(resourceGroup().id))]",
      "metadata": {
        "description": "Name of the tenant's Key Vault. Must be globally unique, 3-24 chars."
      }
    },
    "privateEndpointSubnetPrefix": {
      "type": "string",
      "defaultValue": "10.237.0.0/24",
      "metadata": {
        "description": "Address prefix for the private-endpoint subnet, inside the cluster vnet."
      }
    },
    "clusterVnetName": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Name of the AKS-managed virtual network. AKS derives this name itself and it cannot be computed, so the control plane looks it up and passes it in. Empty on the first stamp — the cluster does not exist yet — and the private networking is created on the next sweep."
      }
    }
  },
  "variables": {
    "prefix": "cortex",
    "tenantId": "[subscription().tenantId]",
    "subscriptionId": "[subscription().subscriptionId]",
    "foundryProjectEndpoint": "[format('https://{0}.services.ai.azure.com/api/projects/{1}', parameters('foundryAccountName'), parameters('foundryProjectName'))]",
    "foundryProjectDisplay": "[format('{0}/{1}', parameters('foundryAccountName'), parameters('foundryProjectName'))]",
    "foundryUserRoleId": "53ca6127-db72-4b80-b1b0-d745d6d5456d",
    "createReconIdentity": "[empty(parameters('reconcilerIdentityResourceId'))]",
    "reconIdentityName": "[if(variables('createReconIdentity'), format('{0}-recon', variables('prefix')), last(split(parameters('reconcilerIdentityResourceId'), '/')))]",
    "reconIdentityId": "[if(variables('createReconIdentity'), resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-recon', variables('prefix'))), resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('reconIdentityName')))]",
    "nodeResourceGroupName": "[format('MC_{0}_{1}_{2}', resourceGroup().name, parameters('clusterName'), parameters('location'))]",
    "aksRbacClusterAdminRoleId": "b1ff04bb-8a4e-4dc4-8eb5-8693973ce19b",
    "aksClusterUserRoleId": "4abbcc35-e782-43d8-92c5-2d3f1bd2253f",
    "dnsZoneContributorRoleId": "befefa01-2a29-4197-83a8-272ff33ce314",
    "clusterEnabled": "[parameters('deployCluster')]",
    "helmOciSecretName": "helm-oci-password",
    "helmOciSecrets": "[if(empty(parameters('helmOciPassword')), createArray(), createArray(createObject('name', variables('helmOciSecretName'), 'value', parameters('helmOciPassword'))))]",
    "helmOciEnv": "[if(empty(parameters('helmOciPassword')), createArray(), createArray(createObject('name', 'HELM_OCI_PASSWORD', 'secretRef', variables('helmOciSecretName'))))]",
    "keyVaultSecretsUserRoleId": "4633458b-17de-408a-b874-0445c86b69e6",
    "deployPrivateNetworking": "[and(parameters('deployCluster'), not(empty(parameters('clusterVnetName'))))]",
    "privateDnsZoneNames": [
      "privatelink.vaultcore.azure.net",
      "[format('privatelink.blob.{0}', environment().suffixes.storage)]",
      "privatelink.cognitiveservices.azure.com",
      "privatelink.azconfig.io",
      "privatelink.postgres.database.azure.com",
      "privatelink.redis.cache.windows.net",
      "[format('privatelink.{0}.redisenterprise.cache.azure.net', parameters('location'))]",
      "privatelink.search.windows.net",
      "privatelink.servicebus.windows.net"
    ]
  },
  "resources": [
    {
      "condition": "[parameters('deployReconcilerApp')]",
      "type": "Microsoft.OperationalInsights/workspaces",
      "apiVersion": "2023-09-01",
      "name": "[format('{0}-recon-logs', variables('prefix'))]",
      "location": "[parameters('location')]",
      "properties": {
        "sku": {
          "name": "PerGB2018"
        },
        "retentionInDays": 30
      }
    },
    {
      "condition": "[variables('createReconIdentity')]",
      "type": "Microsoft.ManagedIdentity/userAssignedIdentities",
      "apiVersion": "2023-01-31",
      "name": "[format('{0}-recon', variables('prefix'))]",
      "location": "[parameters('location')]"
    },
    {
      "type": "Microsoft.CognitiveServices/accounts",
      "apiVersion": "2026-05-01",
      "name": "[parameters('foundryAccountName')]",
      "location": "[parameters('location')]",
      "kind": "AIServices",
      "sku": {
        "name": "S0"
      },
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "customSubDomainName": "[parameters('foundryAccountName')]",
        "allowProjectManagement": true,
        "publicNetworkAccess": "Enabled",
        "disableLocalAuth": true
      }
    },
    {
      "type": "Microsoft.CognitiveServices/accounts/projects",
      "apiVersion": "2026-05-01",
      "name": "[format('{0}/{1}', parameters('foundryAccountName'), parameters('foundryProjectName'))]",
      "location": "[parameters('location')]",
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "displayName": "[parameters('foundryProjectName')]",
        "description": "[format('Cortex-managed agents for {0}', parameters('tenantName'))]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.CognitiveServices/accounts', parameters('foundryAccountName'))]"
      ]
    },
    {
      "type": "Microsoft.CognitiveServices/accounts/deployments",
      "apiVersion": "2024-10-01",
      "name": "[format('{0}/{1}', parameters('foundryAccountName'), parameters('modelDeploymentName'))]",
      "sku": {
        "name": "[parameters('modelSkuName')]",
        "capacity": "[parameters('modelCapacity')]"
      },
      "properties": {
        "model": "[union(createObject('format', 'OpenAI', 'name', parameters('modelName')), if(empty(parameters('modelVersion')), createObject(), createObject('version', parameters('modelVersion'))))]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.CognitiveServices/accounts', parameters('foundryAccountName'))]",
        "[resourceId('Microsoft.CognitiveServices/accounts/projects', parameters('foundryAccountName'), parameters('foundryProjectName'))]"
      ]
    },
    {
      "type": "Microsoft.CognitiveServices/accounts/deployments",
      "apiVersion": "2024-10-01",
      "name": "[format('{0}/{1}', parameters('foundryAccountName'), parameters('embeddingDeploymentName'))]",
      "sku": {
        "name": "[parameters('embeddingSkuName')]",
        "capacity": "[parameters('embeddingCapacity')]"
      },
      "properties": {
        "model": "[union(createObject('format', 'OpenAI', 'name', parameters('embeddingModelName')), if(empty(parameters('embeddingModelVersion')), createObject(), createObject('version', parameters('embeddingModelVersion'))))]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.CognitiveServices/accounts', parameters('foundryAccountName'))]",
        "[resourceId('Microsoft.CognitiveServices/accounts/deployments', parameters('foundryAccountName'), parameters('modelDeploymentName'))]"
      ]
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[resourceId('Microsoft.CognitiveServices/accounts', parameters('foundryAccountName'))]",
      "name": "[guid(resourceId('Microsoft.CognitiveServices/accounts', parameters('foundryAccountName')), variables('reconIdentityId'), variables('foundryUserRoleId'))]",
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('foundryUserRoleId'))]",
        "principalId": "[if(variables('createReconIdentity'), reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-recon', variables('prefix'))), '2023-01-31').principalId, reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('reconIdentityName')), '2023-01-31').principalId)]",
        "principalType": "ServicePrincipal",
        "delegatedManagedIdentityResourceId": "[if(parameters('isDelegated'), variables('reconIdentityId'), null())]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.CognitiveServices/accounts', parameters('foundryAccountName'))]",
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-recon', variables('prefix')))]"
      ]
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[resourceId('Microsoft.CognitiveServices/accounts/projects', parameters('foundryAccountName'), parameters('foundryProjectName'))]",
      "name": "[guid(resourceId('Microsoft.CognitiveServices/accounts/projects', parameters('foundryAccountName'), parameters('foundryProjectName')), variables('foundryUserRoleId'), 'project-mi')]",
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('foundryUserRoleId'))]",
        "principalId": "[reference(resourceId('Microsoft.CognitiveServices/accounts/projects', parameters('foundryAccountName'), parameters('foundryProjectName')), '2026-05-01', 'full').identity.principalId]",
        "principalType": "ServicePrincipal",
        "delegatedManagedIdentityResourceId": "[if(parameters('isDelegated'), resourceId('Microsoft.CognitiveServices/accounts/projects', parameters('foundryAccountName'), parameters('foundryProjectName')), null())]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.CognitiveServices/accounts/projects', parameters('foundryAccountName'), parameters('foundryProjectName'))]"
      ]
    },
    {
      "condition": "[parameters('deployCluster')]",
      "type": "Microsoft.ContainerService/managedClusters",
      "apiVersion": "2025-09-02-preview",
      "name": "[parameters('clusterName')]",
      "location": "[parameters('location')]",
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "dnsPrefix": "[parameters('clusterName')]",
        "nodeResourceGroup": "[variables('nodeResourceGroupName')]",
        "kubernetesVersion": "[if(empty(parameters('kubernetesVersion')), null(), parameters('kubernetesVersion'))]",
        "enableRBAC": true,
        "disableLocalAccounts": true,
        "oidcIssuerProfile": {
          "enabled": true
        },
        "securityProfile": {
          "workloadIdentity": {
            "enabled": true
          }
        },
        "aadProfile": {
          "managed": true,
          "enableAzureRBAC": true,
          "tenantID": "[variables('tenantId')]"
        },
        "agentPoolProfiles": [
          {
            "name": "system",
            "mode": "System",
            "count": "[parameters('nodeCount')]",
            "vmSize": "[parameters('nodeVmSize')]",
            "osType": "Linux",
            "osSKU": "AzureLinux",
            "type": "VirtualMachineScaleSets"
          }
        ],
        "ingressProfile": {
          "gatewayAPI": {
            "installation": "Standard"
          },
          "applicationLoadBalancer": {
            "enabled": true
          }
        }
      }
    },
    {
      "condition": "[and(parameters('deployCluster'), greater(parameters('workloadNodeCount'), 0))]",
      "type": "Microsoft.ContainerService/managedClusters/agentPools",
      "apiVersion": "2024-09-01",
      "name": "[format('{0}/{1}', parameters('clusterName'), 'workload')]",
      "properties": {
        "mode": "User",
        "count": "[parameters('workloadNodeCount')]",
        "vmSize": "[parameters('workloadNodeVmSize')]",
        "osType": "Linux",
        "osSKU": "AzureLinux",
        "type": "VirtualMachineScaleSets"
      },
      "dependsOn": [
        "[resourceId('Microsoft.ContainerService/managedClusters', parameters('clusterName'))]"
      ]
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "[guid(resourceGroup().id, variables('reconIdentityId'), variables('dnsZoneContributorRoleId'))]",
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('dnsZoneContributorRoleId'))]",
        "principalId": "[if(variables('createReconIdentity'), reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-recon', variables('prefix'))), '2023-01-31').principalId, reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('reconIdentityName')), '2023-01-31').principalId)]",
        "principalType": "ServicePrincipal",
        "delegatedManagedIdentityResourceId": "[if(parameters('isDelegated'), variables('reconIdentityId'), null())]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-recon', variables('prefix')))]"
      ]
    },
    {
      "condition": "[parameters('deployCluster')]",
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[resourceId('Microsoft.ContainerService/managedClusters', parameters('clusterName'))]",
      "name": "[guid(parameters('clusterName'), variables('reconIdentityId'), variables('aksRbacClusterAdminRoleId'))]",
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('aksRbacClusterAdminRoleId'))]",
        "principalId": "[if(variables('createReconIdentity'), reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-recon', variables('prefix'))), '2023-01-31').principalId, reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('reconIdentityName')), '2023-01-31').principalId)]",
        "principalType": "ServicePrincipal",
        "delegatedManagedIdentityResourceId": "[if(parameters('isDelegated'), variables('reconIdentityId'), null())]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.ContainerService/managedClusters', parameters('clusterName'))]",
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-recon', variables('prefix')))]"
      ]
    },
    {
      "condition": "[parameters('deployCluster')]",
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[resourceId('Microsoft.ContainerService/managedClusters', parameters('clusterName'))]",
      "name": "[guid(parameters('clusterName'), variables('reconIdentityId'), variables('aksClusterUserRoleId'))]",
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('aksClusterUserRoleId'))]",
        "principalId": "[if(variables('createReconIdentity'), reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-recon', variables('prefix'))), '2023-01-31').principalId, reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('reconIdentityName')), '2023-01-31').principalId)]",
        "principalType": "ServicePrincipal",
        "delegatedManagedIdentityResourceId": "[if(parameters('isDelegated'), variables('reconIdentityId'), null())]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.ContainerService/managedClusters', parameters('clusterName'))]",
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-recon', variables('prefix')))]"
      ]
    },
    {
      "condition": "[parameters('deployReconcilerApp')]",
      "type": "Microsoft.App/managedEnvironments",
      "apiVersion": "2024-03-01",
      "name": "[format('{0}-recon-env', variables('prefix'))]",
      "location": "[parameters('location')]",
      "properties": {
        "appLogsConfiguration": {
          "destination": "log-analytics",
          "logAnalyticsConfiguration": {
            "customerId": "[reference(resourceId('Microsoft.OperationalInsights/workspaces', format('{0}-recon-logs', variables('prefix'))), '2023-09-01').customerId]",
            "sharedKey": "[listKeys(resourceId('Microsoft.OperationalInsights/workspaces', format('{0}-recon-logs', variables('prefix'))), '2023-09-01').primarySharedKey]"
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.OperationalInsights/workspaces', format('{0}-recon-logs', variables('prefix')))]"
      ]
    },
    {
      "condition": "[parameters('deployReconcilerApp')]",
      "type": "Microsoft.App/containerApps",
      "apiVersion": "2024-03-01",
      "name": "[format('{0}-reconciler', variables('prefix'))]",
      "location": "[parameters('location')]",
